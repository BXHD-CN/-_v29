# ===== 基础 =====
ENV=dev
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_MINUTES=180
# 生产 HTTPS 下必须 true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ===== 数据库 =====
# 本地开发：SQLite
DATABASE_URL=sqlite:///./data/app.db
# 生产：PostgreSQL + pgvector
# DATABASE_URL=postgresql+psycopg://app:password@db:5432/ait

# ===== 向量 =====
# local=本地哈希（离线可用，演示兜底）；bigmodel=智谱 embedding-3（作业要求）
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=1024
BIGMODEL_API_KEY=
BIGMODEL_BASE=https://open.bigmodel.cn/api/paas/v4
BIGMODEL_EMBEDDING_MODEL=embedding-3

# ===== 生成 =====
# mock=不调模型（只给检索摘录）；deepseek；generic=任意 OpenAI 兼容服务
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
GENERIC_BASE=
GENERIC_API_KEY=
GENERIC_MODEL=

# ===== 翻译 =====
# mock=术语+句对拼装；deepseek；generic=任意 MT 端口（百度/腾讯/DeepL 等）
MT_PROVIDER=mymemory
GENERIC_MT_URL=
GENERIC_MT_KEY=
GENERIC_MT_METHOD=POST
GENERIC_MT_PAYLOAD_TPL={"q": "{text}", "source": "{src}", "target": "{tgt}"}
GENERIC_MT_RESULT_PATH=trans_result.0.dst
# 可选：MyMemory 官方 de= 参数（填邮箱可提高免费额度）
MYMEMORY_EMAIL=

# ===== 检索 =====
QA_TOP_K=5
REFUSE_THRESHOLD=0.35
MAX_TEXT_LEN=2000

# ===== 语音识别（v=27）=====
# mock=课程演示（不联网、返回 demo=true 的可复现示例文本）；http=服务端中转第三方 ASR
# 密钥只写在这里（服务端），前端永远只连同源 /api/speech/recognize
ASR_PROVIDER=mock
ASR_HTTP_URL=
ASR_HTTP_KEY=
ASR_HTTP_TIMEOUT=20
# 单次上传上限 / 最长录音 / 每 IP 每分钟识别次数
ASR_MAX_AUDIO_BYTES=8388608
ASR_MAX_DURATION_MS=60000
ASR_RATE_LIMIT=10
# 可选：演示模式默认口述内容（留空则用内置示例句）
ASR_DEMO_TEXT=
ASR_DEMO_TEXT_EN=
